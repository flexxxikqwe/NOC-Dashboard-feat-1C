// ==============================================================================
// МОДУЛЬ ТЕСТОВОЙ ПЕСОЧНИЦЫ 1С (BSL SANDBOX) — ВЕРИФИКАЦИЯ РИСКА Б
// Назначение: Замер скорости сбора телеметрии и безопасная отправка в NOC Gateway.
// Контекст исполнения: Клиент-серверное или толстый/тонкий клиент 1С:Предприятие 8.3
// Требование безопасности: Нулевая блокировка кассира, жесткие сетевые таймауты.
// ==============================================================================

#Область ПрограммныйИнтерфейс

// Точка входа для запуска комплексного бенчмарка из формы или внешней обработки
&НаКлиенте
Процедура ЗапуститьБенчмаркКлиент() Экспорт

	Сообщить("=================================================================");
	Сообщить("🚀 [NOC BSL SANDBOX] СТАРТ КОМПЛЕКСНОГО ТЕСТИРОВАНИЯ И БЕНЧМАРКА");
	Сообщить("=================================================================");

	ВремяСтартаОбщее = ТекущаяУниверсальнаяДатаВМиллисекундах();

	// Параметры подключения к серверному шлюзу
	НастройкиПодключения = Новый Структура;
	НастройкиПодключения.Вставить("Хост", "127.0.0.1");
	НастройкиПодключения.Вставить("Порт", 3000);
	НастройкиПодключения.Вставить("ПутьРесурса", "/api/v1/telemetry");
	НастройкиПодключения.Вставить("Токен", "dev-secret-token-2026");
	НастройкиПодключения.Вставить("ТаймаутСек", 3);
	НастройкиПодключения.Вставить("ИспользоватьHTTPS", Ложь);

	// --------------------------------------------------------------------------
	// ТЕСТ 1: Каскадный парсинг утилит удаленного доступа (AnyDesk / RuDesktop)
	// --------------------------------------------------------------------------
	Сообщить("");
	Сообщить("▶ [ТЕСТ 1] Каскадный парсинг утилит удаленного доступа...");
	ТаймерСтарт1 = ТекущаяУниверсальнаяДатаВМиллисекундах();

	ДанныеУдаленногоДоступа = ОпределитьИдентификаторУдаленногоДоступа();

	ДлительностьТест1 = ТекущаяУниверсальнаяДатаВМиллисекундах() - ТаймерСтарт1;
	Сообщить(СтрШаблон("   ✓ Обнаружен тип: %1", ДанныеУдаленногоДоступа.type));
	Сообщить(СтрШаблон("   ✓ Идентификатор: %1", ДанныеУдаленногоДоступа.id));
	Сообщить(СтрШаблон("   ⏱ Длительность Теста 1: %1 мс (целевой бенчмарк <= 2 мс)", ДлительностьТест1));

	// --------------------------------------------------------------------------
	// ТЕСТ 2: Безопасное чтение Журнала регистрации (Event Log)
	// --------------------------------------------------------------------------
	Сообщить("");
	Сообщить("▶ [ТЕСТ 2] Безопасная выгрузка Журнала регистрации (последние 10 минут)...");
	ТаймерСтарт2 = ТекущаяУниверсальнаяДатаВМиллисекундах();

	МассивОшибок = ПолучитьОшибкиЖурналаРегистрацииНаСервере();

	ДлительностьТест2 = ТекущаяУниверсальнаяДатаВМиллисекундах() - ТаймерСтарт2;
	Сообщить(СтрШаблон("   ✓ Извлечено критических ошибок: %1 шт.", МассивОшибок.Количество()));
	Сообщить(СтрШаблон("   ⏱ Длительность Теста 2: %1 мс (целевой бенчмарк <= 100 мс)", ДлительностьТест2));

	// --------------------------------------------------------------------------
	// ТЕСТ 3: Сериализация в JSON и сетевой транспорт с Fail-Safe защитой
	// --------------------------------------------------------------------------
	Сообщить("");
	Сообщить("▶ [ТЕСТ 3] Сериализация JSON и сетевой транспорт (Таймаут 3 сек, Fail-Safe)...");
	ТаймерСтарт3 = ТекущаяУниверсальнаяДатаВМиллисекундах();

	// Формирование структуры DTO строго по контракту TelemetryPayload
	ПакетТелеметрии = Новый Структура;
	ПакетТелеметрии.Вставить("shop", "Тестовый Магазин Розница №1");
	ПакетТелеметрии.Вставить("workplace", "Касса №1 Основная");
	ПакетТелеметрии.Вставить("remote", ДанныеУдаленногоДоступа);

	МассивПредупреждений = Новый Массив;
	МассивПредупреждений.Добавить("Тестовый запуск песочницы BSL");
	ПакетТелеметрии.Вставить("warnings", МассивПредупреждений);
	ПакетТелеметрии.Вставить("runtime_errors", МассивОшибок);

	// Сериализация пакета в строку JSON
	СтрокаJSON = СериализоватьСтруктуруВJSON(ПакетТелеметрии);

	// Отправка в шлюз с изоляцией исключений
	РезультатОтправки = ОтправитьПакетВШлюз(СтрокаJSON, НастройкиПодключения);

	ДлительностьТест3 = ТекущаяУниверсальнаяДатаВМиллисекундах() - ТаймерСтарт3;
	Сообщить(СтрШаблон("   ⏱ Длительность Теста 3 (транспорт): %1 мс", ДлительностьТест3));

	// --------------------------------------------------------------------------
	// ИТОГОВЫЙ ОТЧЕТ БЕНЧМАРКА
	// --------------------------------------------------------------------------
	ОбщееВремя = ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяСтартаОбщее;
	Сообщить("");
	Сообщить("=================================================================");
	Сообщить(СтрШаблон("🏁 ИТОГО: Полный цикл сбора и отправки выполнен за %1 мс", ОбщееВремя));
	Сообщить(СтрШаблон("   - Парсинг Remote ID: %1 мс", ДлительностьТест1));
	Сообщить(СтрШаблон("   - Чтение журнала:    %1 мс", ДлительностьТест2));
	Сообщить(СтрШаблон("   - Сеть и JSON:       %1 мс", ДлительностьТест3));
	Сообщить("=================================================================");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Каскадное определение параметров удаленного доступа AnyDesk -> RuDesktop -> NONE
// Возвращает структуру: { type: "ANYDESK" | "RUDESKTOP" | "NONE", id: Строка }
&НаКлиенте
Функция ОпределитьИдентификаторУдаленногоДоступа()

	Результат = Новый Структура;
	Результат.Вставить("type", "NONE");
	Результат.Вставить("id", "");

	Попытка
		// 1. Попытка обнаружения AnyDesk
		КаталогProgramData = ПолучитьПеременнуюСредыКл("ProgramData");
		Если ПустаяСтрока(КаталогProgramData) Тогда
			КаталогProgramData = "C:\ProgramData";
		КонецЕсли;

		ПутьAnyDeskConf = КаталогProgramData + "\AnyDesk\system.conf";
		ФайлAnyDesk = Новый Файл(ПутьAnyDeskConf);

		Если ФайлAnyDesk.Существует() Тогда
			ЧтениеКонфига = Новый ЧтениеТекста(ПутьAnyDeskConf, КодировкаТекста.ANSI);
			СтрокаФайла = ЧтениеКонфига.ПрочитатьСтроку();
			Пока СтрокаФайла <> Неопределено Докл
				СтрокаФайла = СокрЛП(СтрокаФайла);
				Если СтрНачинаетсяС(СтрокаФайла, "ad.anynet.id=") Тогда
					НайденныйИД = СокрЛП(Сред(СтрокаФайла, СтрДлина("ad.anynet.id=") + 1));
					Если НЕ ПустаяСтрока(НайденныйИД) Тогда
						Результат.type = "ANYDESK";
						Результат.id = НайденныйИД;
						ЧтениеКонфига.Закрыть();
						Возврат Результат;
					КонецЕсли;
				КонецЕсли;
				СтрокаФайла = ЧтениеКонфига.ПрочитатьСтроку();
			КонецЦикла;
			ЧтениеКонфига.Закрыть();
		КонецЕсли;

		// 2. Fallback на RuDesktop
		ПутьRuDesktopConf = КаталогProgramData + "\RuDesktop\rudesktop.cfg";
		ФайлRuDesktop = Новый Файл(ПутьRuDesktopConf);

		Если ФайлRuDesktop.Существует() Тогда
			ЧтениеКонфига = Новый ЧтениеТекста(ПутьRuDesktopConf, КодировкаТекста.UTF8);
			СтрокаФайла = ЧтениеКонфига.ПрочитатьСтроку();
			Пока СтрокаФайла <> Неопределено Докл
				СтрокаФайла = СокрЛП(СтрокаФайла);
				Если СтрНачинаетсяС(СтрокаФайла, "id=") Или СтрНачинаетсяС(СтрокаФайла, "client_id=") Тогда
					ПозицияРавно = СтрНайти(СтрокаФайла, "=");
					НайденныйИД = СокрЛП(Сред(СтрокаФайла, ПозицияРавно + 1));
					Если НЕ ПустаяСтрока(НайденныйИД) Тогда
						Результат.type = "RUDESKTOP";
						Результат.id = НайденныйИД;
						ЧтениеКонфига.Закрыть();
						Возврат Результат;
					КонецЕсли;
				КонецЕсли;
				СтрокаФайла = ЧтениеКонфига.ПрочитатьСтроку();
			КонецЦикла;
			ЧтениеКонфига.Закрыть();
		КонецЕсли;

	Исключение
		// При любых ошибках прав доступа или файловой системы не прерываем работу кассы
		Результат.type = "NONE";
		Результат.id = "";
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Безопасное получение переменной среды на клиенте Windows
&НаКлиенте
Функция ПолучитьПеременнуюСредыКл(ИмяПеременной)

	Попытка
		WshShell = Новый COMОбъект("WScript.Shell");
		Возврат WshShell.ExpandEnvironmentStrings("%" + ИмяПеременной + "%");
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

// Чтение последних критических записей из Журнала регистрации без перегрузки диска
// Возвращает массив структур: [{ time: "...", event: "...", error_text: "..." }]
&НаСервереБезКонтекста
Функция ПолучитьОшибкиЖурналаРегистрацииНаСервере()

	МассивОшибок = Новый Массив;

	Попытка
		// Фильтр строго за последние 10 минут (600 секунд) только ошибок
		ФильтрЖР = Новый Структура;
		ФильтрЖР.Вставить("ДатаНачала", ТекущаяДата() - 600);

		МассивУровней = Новый Массив;
		МассивУровней.Добавить(УровеньЖурналаРегистрации.Ошибка);
		ФильтрЖР.Вставить("Уровень", МассивУровней);

		ТаблицаЖР = Новый ТаблицаЗначений;

		// Ограничение выборки максимум 50 записями для мгновенного отклика
		ВыгрузитьЖурналРегистрации(
			ТаблицаЖР,
			ФильтрЖР,
			"Дата, ИмяСобытия, ОписаниеОшибки",
			50
		);

		Для Каждого СтрЛога Из ТаблицаЖР Цикл
			ЗаписьОшибки = Новый Структура;
			ЗаписьОшибки.Вставить("time", Формат(СтрЛога.Дата, "ДФ=yyyy-MM-ddTHH:mm:ssZ"));
			ЗаписьОшибки.Вставить("event", ?(ПустаяСтрока(СтрЛога.ИмяСобытия), "1C_Runtime_Error", СтрЛога.ИмяСобытия));
			ЗаписьОшибки.Вставить("error_text", СокрЛП(СтрЛога.ОписаниеОшибки));
			МассивОшибок.Добавить(ЗаписьОшибки);
		КонецЦикла;

	Исключение
		// В случае сбоя доступа к ЖР возвращаем пустой массив без падения модуля
		ЗаписьОшибки = Новый Структура;
		ЗаписьОшибки.Вставить("time", Формат(ТекущаяДата(), "ДФ=yyyy-MM-ddTHH:mm:ssZ"));
		ЗаписьОшибки.Вставить("event", "EventLog_Access_Exception");
		ЗаписьОшибки.Вставить("error_text", ОписаниеОшибки());
		МассивОшибок.Добавить(ЗаписьОшибки);
	КонецПопытки;

	Возврат МассивОшибок;

КонецФункции

// Сериализация структуры в чистый формат JSON без платформенных мета-типов 1С
&НаКлиенте
Функция СериализоватьСтруктуруВJSON(ДанныеДляЗаписи)

	ЗаписьJSON = Новый ЗаписьJSON;
	ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(
		ПереносСтрокJSON.Нет,
		" ",
		Истина,
		ЭкранированиеСимволовJSON.СимволыВнеASCII
	);
	ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписи);

	ЗаписатьJSON(ЗаписьJSON, ДанныеДляЗаписи);
	СтрокаJSON = ЗаписьJSON.Закрыть();

	Возврат СтрокаJSON;

КонецФункции

// Отправка пакета в Ingestion Gateway с жестким таймаутом 3с и изоляцией исключений
&НаКлиенте
Функция ОтправитьПакетВШлюз(СтрокаJSON, Настройки)

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("КодСостояния", 0);
	Результат.Вставить("ОтветТекст", "");

	ЗамерСетиСтарт = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Попытка
		// Инициализация соединения со строгим таймаутом 3 секунды
		Соединение = Новый HTTPСоединение(
			Настройки.Хост,
			Настройки.Порт,
			, // Пользователь
			, // Пароль
			, // Прокси
			Настройки.ТаймаутСек,
			?(Настройки.ИспользоватьHTTPS, Новый ЗащищенноеСоединениеOpenSSL(), Неопределено)
		);

		Запрос = Новый HTTPЗапрос(Настройки.ПутьРесурса);
		Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Запрос.Заголовки.Вставить("Authorization", "Bearer " + Настройки.Токен);
		Запрос.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);

		Ответ = Соединение.ОтправитьДляОбработки(Запрос);
		КодОтвета = Ответ.КодСостояния;
		ТелоОтвета = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);

		Результат.КодСостояния = КодОтвета;
		Результат.ОтветТекст = ТелоОтвета;

		Если КодОтвета = 200 Тогда
			Результат.Успех = Истина;
			Сообщить(СтрШаблон("   ✓ HTTP 200 OK получено от сервера. Ответ: %1", ТелоОтвета));

			// Чтение директивного ответа сервера
			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
			ОтветСтруктура = ПрочитатьJSON(ЧтениеJSON);
			ЧтениеJSON.Закрыть();

			Если ОтветСтруктура <> Неопределено И ОтветСтруктура.Свойство("config") Тогда
				Сообщить(СтрШаблон("   ✓ Директива сервера: следующий опрос через %1 сек.", 
					Строка(ОтветСтруктура.config.next_check_seconds)));
			КонецЕсли;
		Иначе
			Сообщить(СтрШаблон("   ⚠ Сервер вернул код HTTP %1: %2", КодОтвета, ТелоОтвета));
		КонецЕсли;

	Исключение
		// КРИТИЧЕСКИЙ СЛОЙ FAIL-SAFE:
		// Любой сетевой сбой (offline, сброс TCP, таймаут 3с) подавляется.
		// Кассир не получает модальных окон ошибки 1С.
		ДлительностьСбоя = ТекущаяУниверсальнаяДатаВМиллисекундах() - ЗамерСетиСтарт;
		Сообщить(СтрШаблон("   [FAIL-SAFE OK] Сетевой сбой безопасно подавлен, UI не заблокирован (%1 мс). Причина: %2",
			ДлительностьСбоя, ОписаниеОшибки()));
		Результат.Успех = Ложь;
		Результат.ОтветТекст = ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;

КонецФункции

#КонецОбласти
