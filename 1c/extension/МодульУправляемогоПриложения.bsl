// ==============================================================================
// МОДУЛЬ УПРАВЛЯЕМОГО ПРИЛОЖЕНИЯ РАСШИРЕНИЯ «_МониторСаппорта»
// Префикс: _МС_
// Контекст исполнения: Клиентский сеанс управляемого приложения (Кассовый терминал)
// Безопасность: Нулевая блокировка кассира, изоляция в Попытка ... Исключение
// ==============================================================================

#Область ОбработчикиСобытий

&НаКлиенте
Процедура _МС_ПриНачалеРаботыСистемы()

	// Гарантированная защита от любых сбоев при старте рабочего места кассира
	Попытка
		// 1. Быстрый каскадный опрос конфигураций утилит удаленного доступа (AnyDesk / RuDesktop)
		ПараметрыДоступа = _МС_ОпределитьПараметрыУдаленногоДоступаНаКлиенте();

		// 2. Кэширование параметров на сервере (во временном хранилище / параметрах сеанса)
		_МС_Сервер.СохранитьПараметрыУдаленногоДоступаСеанса(ПараметрыДоступа);

	Исключение
		// Категорически запрещено выводить модальные окна пользователю при сбое сбора телеметрии.
		// Запись краткой отладочной информации в локальный журнал (если доступен).
		ЗаписьЖурналаРегистрации(
			"_МС_МониторСаппорта.СтартСеанса",
			УровеньЖурналаРегистрации.Предупреждение,,,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())
		);
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункцииКлиента

// Каскадное определение параметров удаленного доступа AnyDesk -> RuDesktop -> NONE
// Возвращает структуру: { type: "ANYDESK" | "RUDESKTOP" | "NONE", id: Строка }
&НаКлиенте
Функция _МС_ОпределитьПараметрыУдаленногоДоступаНаКлиенте()

	Результат = Новый Структура;
	Результат.Вставить("type", "NONE");
	Результат.Вставить("id", "");

	Попытка
		// 1. Попытка обнаружения AnyDesk в каталоге ProgramData
		КаталогProgramData = _МС_ПолучитьПеременнуюСредыКл("ProgramData");
		Если ПустаяСтрока(КаталогProgramData) Тогда
			КаталогProgramData = "C:\ProgramData";
		КонецЕсли;

		ПутьAnyDeskConf = КаталогProgramData + "\AnyDesk\system.conf";
		ФайлAnyDesk = Новый Файл(ПутьAnyDeskConf);

		Если ФайлAnyDesk.Существует() Тогда
			ЧтениеКонфига = Новый ЧтениеТекста(ПутьAnyDeskConf, КодировкаТекста.ANSI);
			СтрокаФайла = ЧтениеКонфига.ПрочитатьСтроку();
			Пока СтрокаФайла <> Неопределено Цикл
				СтрокаФайла = СокрЛП(СтрокаФайла);
				Если СтрНачинаетсяС(СтрокаФайла, "ad.anynet.id=") Тогда
					НайденныйИД = СокрЛП(Сред(СтрокаФайла, СтрДлина("ad.anynet.id=") + 1));
					Если НЕ ПустаяСтрока(НайденныйИД) Тогда
						Результат.type = "ANYDESK";
						Результат.id = НайденныйИД;
						ЧтениеКонфига.Закрыть();
						Возврат Результат;
					КонецЕсли;
				КонецЕсли;
				СтрокаФайла = ЧтениеКонфига.ПрочитатьСтроку();
			КонецЦикла;
			ЧтениеКонфига.Закрыть();
		КонецЕсли;

		// 2. Fallback на RuDesktop в каталоге ProgramData
		ПутьRuDesktopConf = КаталогProgramData + "\RuDesktop\rudesktop.cfg";
		ФайлRuDesktop = Новый Файл(ПутьRuDesktopConf);

		Если ФайлRuDesktop.Существует() Тогда
			ЧтениеКонфига = Новый ЧтениеТекста(ПутьRuDesktopConf, КодировкаТекста.UTF8);
			СтрокаФайла = ЧтениеКонфига.ПрочитатьСтроку();
			Пока СтрокаФайла <> Неопределено Цикл
				СтрокаФайла = СокрЛП(СтрокаФайла);
				Если СтрНачинаетсяС(СтрокаФайла, "id=") Или СтрНачинаетсяС(СтрокаФайла, "client_id=") Тогда
					ПозицияРавно = СтрНайти(СтрокаФайла, "=");
					НайденныйИД = СокрЛП(Сред(СтрокаФайла, ПозицияРавно + 1));
					Если НЕ ПустаяСтрока(НайденныйИД) Тогда
						Результат.type = "RUDESKTOP";
						Результат.id = НайденныйИД;
						ЧтениеКонфига.Закрыть();
						Возврат Результат;
					КонецЕсли;
				КонецЕсли;
				СтрокаФайла = ЧтениеКонфига.ПрочитатьСтроку();
			КонецЦикла;
			ЧтениеКонфига.Закрыть();
		КонецЕсли;

	Исключение
		// При любых ошибках доступа к файловой системе касса функционирует без задержек
		Результат.type = "NONE";
		Результат.id = "";
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Безопасное чтение переменной окружения через COM-объект WScript.Shell (Windows)
&НаКлиенте
Функция _МС_ПолучитьПеременнуюСредыКл(ИмяПеременной)

	Попытка
		WshShell = Новый COMОбъект("WScript.Shell");
		Возврат WshShell.ExpandEnvironmentStrings("%" + ИмяПеременной + "%");
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

#КонецОбласти
