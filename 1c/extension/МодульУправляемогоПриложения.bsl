// ==============================================================================
// МОДУЛЬ УПРАВЛЯЕМОГО ПРИЛОЖЕНИЯ (КЛИЕНТСКИЙ КОНТУР 1С)
// Назначение: Перехват старта сеанса без блокировки кассира (Phase 4.1 Zero-Freeze).
// Принцип безопасности:
//   - Никаких сетевых обращений к шлюзу из клиентского потока.
//   - Никаких COM/WMI вызовов при входе кассира.
//   - Нулевое влияние на скорость открытия РМК.
// ==============================================================================

#Область СлужебныйРежим

&Вместо("ПриНачалеРаботыСистемы")
Процедура _МС_ПриНачалеРаботыСистемы()

	ПродолжитьВызов();

	// Phase 4.1.1 Zero-Freeze: безопасная регистрация периодического мониторинга для файловых баз 1С.
	// 1. При старте кассы не выполняется никаких синхронных сетевых или файловых операций (задержка старта РМК 0 мс).
	// 2. Фоновый обработчик ожидания подключается с интервалом 600 секунд (10 минут).
	// 3. Первый вызов произойдет через 10 минут после полного открытия кассового интерфейса.
	Попытка
		ПодключитьОбработчикОжидания("_МС_ТихийСтартМониторинга", 600);
	Исключение
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура _МС_ТихийСтартМониторинга() Экспорт

	// Вызов серверной процедуры формирования пакета spool.
	// Локальная запись в файл spool\ занимает < 1-3 мс, без сети, без WMI/COM.
	Попытка
		_МС_Сервер.ВыполнитьРегламентныйМониторинг();
	Исключение
		// Тихий Fail-Safe режим: сбои локальной очереди никогда не прерывают работу кассира
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункцииКлиента

// Заглушка обратной совместимости (парсинг удаленного доступа перенесен в Windows Service)
// Ранее производился поиск параметров ad.anynet.id= (AnyDesk) и rudesktop.cfg (RuDesktop).
// В Phase 4.1 Zero-Freeze опрос перенесен в Windows Service (Phase 4.2 / Phase 4.4).
&НаКлиенте
Функция _МС_ОпределитьПараметрыУдаленногоДоступаНаКлиенте() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("type", "NONE");
	Результат.Вставить("id", "");
	Возврат Результат;

КонецФункции

// Безопасное чтение переменной окружения через COM-объект WScript.Shell (Windows)
&НаКлиенте
Функция _МС_ПолучитьПеременнуюСредыКл(ИмяПеременной) Экспорт

	Попытка
		WshShell = Новый COMОбъект("WScript.Shell");
		Шаблон = "%" + ИмяПеременной + "%";
		Значение = WshShell.ExpandEnvironmentStrings(Шаблон);
		WshShell = Неопределено;

		// Если переменная не определена в Windows, WScript.Shell возвращает строку без изменений (%VARIABLE%)
		Если ВРег(СокрЛП(Значение)) = ВРег(Шаблон) Тогда
			Возврат "";
		КонецЕсли;

		Возврат СокрЛП(Значение);
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

#КонецОбласти
