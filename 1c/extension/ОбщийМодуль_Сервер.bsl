// ==============================================================================
// ОБЩИЙ МОДУЛЬ: _МС_Сервер
// Свойства модуля в 1С:
//   - Сервер: Истина
//   - Внешнее соединение: Истина
//   - Клиент (управляемое приложение): Ложь
//   - Привилегированный режим: Истина
// Назначение:
//   1. Сбор и отправка метрик кассы (телеметрия, смена > 24ч, буфер ОФД, ошибки ЖР).
//   2. Безопасное самообслуживание и OTA-обновление расширения.
// ==============================================================================

#Область КонстантыИНастройки

// Получение конфигурации сетевого подключения к NOC-шлюзу
Функция _МС_ПолучитьНастройкиПодключения() Экспорт

	Настройки = Новый Структура;
	Настройки.Вставить("Хост", "127.0.0.1");
	Настройки.Вставить("Порт", 3000);
	Настройки.Вставить("ПутьТелеметрии", "/api/v1/telemetry");
	Настройки.Вставить("ПутьВерсии", "/api/v1/version");
	Настройки.Вставить("Токен", "dev-secret-token-2026");
	Настройки.Вставить("ТаймаутСек", 3);
	Настройки.Вставить("ИспользоватьHTTPS", Ложь);
	Настройки.Вставить("ИмяРасширения", "_МониторСаппорта");
	Настройки.Вставить("ТекущаяВерсия", "1.0.0");

	Возврат Настройки;

КонецФункции

#КонецОбласти

#Область ПрограммныйИнтерфейсРегламентныхЗаданий

// ------------------------------------------------------------------------------
// ПРОЦЕДУРА 1: ВЫПОЛНЕНИЕ РЕГЛАМЕНТНОГО МОНИТОРИНГА (Периодичность: раз в 10 минут)
// Формирует и передает пакет TelemetryPayload на сервер мониторинга
// ------------------------------------------------------------------------------
Процедура ВыполнитьРегламентныйМониторинг() Экспорт

	Попытка
		Настройки = _МС_ПолучитьНастройкиПодключения();

		// 1. Определение идентификаторов магазина и рабочего места
		ПараметрыТочки = _МС_ОпределитьПараметрыМагазинаИКассы();

		// 2. Получение закэшированных параметров удаленного доступа (AnyDesk / RuDesktop)
		ПараметрыДоступа = _МС_ПолучитьПараметрыУдаленногоДоступа();

		// 3. Сбор списка предупреждений (Кассовая смена > 24 часов, очередь фискальных документов)
		МассивПредупреждений = Новый Массив;
		МассивПроверокЗдоровья = Новый Массив;

		_МС_ПроверитьСостояниеКассовойСмены(МассивПредупреждений, МассивПроверокЗдоровья);
		_МС_ПроверитьОчередьЧековОФД(МассивПредупреждений, МассивПроверокЗдоровья);

		// 4. Сбор критических ошибок из Журнала регистрации за последние 10 минут
		МассивОшибок = _МС_ПолучитьОшибкиЖурналаРегистрации();

		// 5. Системная информация о платформе и хосте
		СистемнаяИнформацияСтруктура = _МС_СобратьСистемнуюИнформацию();

		// 6. Формирование DTO-пакета TelemetryPayload
		ПакетТелеметрии = Новый Структура;
		ПакетТелеметрии.Вставить("shop", ПараметрыТочки.shop);
		ПакетТелеметрии.Вставить("workplace", ПараметрыТочки.workplace);
		ПакетТелеметрии.Вставить("remote", ПараметрыДоступа);
		ПакетТелеметрии.Вставить("warnings", МассивПредупреждений);
		ПакетТелеметрии.Вставить("runtime_errors", МассивОшибок);
		ПакетТелеметрии.Вставить("system_info", СистемнаяИнформацияСтруктура);
		ПакетТелеметрии.Вставить("health_checks", МассивПроверокЗдоровья);

		// 7. Сериализация в чистый JSON
		СтрокаJSON = _МС_СериализоватьСтруктуруВJSON(ПакетТелеметрии);

		// 8. Отправка в шлюз со строгим таймаутом 3 секунды
		_МС_ОтправитьПакетВШлюз(СтрокаJSON, Настройки);

	Исключение
		// Исключение полностью изолировано — регламентное задание не должно вызывать блокировок базы
		ЗаписьЖурналаРегистрации(
			"_МС_МониторСаппорта.ОшибкаМониторинга",
			УровеньЖурналаРегистрации.Предупреждение,,,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())
		);
	КонецПопытки;

КонецПроцедуры

// ------------------------------------------------------------------------------
// ПРОЦЕДУРА 2: ВЫПОЛНЕНИЕ АВТООБНОВЛЕНИЯ РАСШИРЕНИЯ (Периодичность: раз в сутки)
// Проверяет наличие новой версии на шлюзе и накатывает .cfe без остановки работы
// ------------------------------------------------------------------------------
Процедура ВыполнитьАвтообновлениеРасширения() Экспорт

	Попытка
		Настройки = _МС_ПолучитьНастройкиПодключения();

		// 1. Запрос метаданных версии с сервера GET /api/v1/version
		Заголовки = Новый Соответствие;
		Заголовки.Вставить("Authorization", "Bearer " + Настройки.Токен);
		Заголовки.Вставить("Accept", "application/json");

		Прокси = Неопределено;
		HTTPСоединение = Новый HTTPСоединение(
			Настройки.Хост,
			Настройки.Порт,,,
			Прокси,
			Настройки.ТаймаутСек,
			Новый ЗащищенноеСоединениеOpenSSL(),
			Настройки.ИспользоватьHTTPS
		);

		HTTPЗапрос = Новый HTTPЗапрос(Настройки.ПутьВерсии, Заголовки);
		HTTPОтвет = HTTPСоединение.Получить(HTTPЗапрос);

		Если HTTPОтвет.КодСостояния <> 200 Тогда
			Возврат;
		КонецЕсли;

		// 2. Разбор полученного JSON версии
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"));
		ДанныеВерсии = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();

		Если ТипЗнч(ДанныеВерсии) <> Тип("Структура") Тогда
			Возврат;
		КонецЕсли;

		ВерсияНаСервере = ДанныеВерсии.version;
		ОтносительныйURL = ДанныеВерсии.download_url;

		// 3. Проверка необходимости обновления
		Если _МС_ВерсияВыше(ВерсияНаСервере, Настройки.ТекущаяВерсия) Тогда

			ЗаписьЖурналаРегистрации(
				"_МС_МониторСаппорта.OTA",
				УровеньЖурналаРегистрации.Информация,,,
				СтрШаблон("Обнаружена новая версия расширения %1 (текущая %2). Загрузка артефакта %3...", ВерсияНаСервере, Настройки.ТекущаяВерсия, ОтносительныйURL)
			);

			// 4. Скачивание бинарного артефакта расширения
			ЗапросCFE = Новый HTTPЗапрос(ОтносительныйURL, Заголовки);
			ОтветCFE = HTTPСоединение.Получить(ЗапросCFE);

			Если ОтветCFE.КодСостояния = 200 Тогда
				ДвоичныеДанныеCFE = ОтветCFE.ПолучитьТелоКакДвоичныеДанные();

				// 5. Применение обновления конфигурации расширения в рантайме
				Расширение = РасширенияКонфигурации.НайтиПоИмени(Настройки.ИмяРасширения);
				Если Расширение <> Неопределено Тогда
					Расширение.Записать(ДвоичныеДанныеCFE);

					ЗаписьЖурналаРегистрации(
						"_МС_МониторСаппорта.OTA_Успех",
						УровеньЖурналаРегистрации.Информация,,,
						СтрШаблон("Расширение %1 успешно обновлено до версии %2.", Настройки.ИмяРасширения, ВерсияНаСервере)
					);
				КонецЕсли;
			КонецЕсли;

		КонецЕсли;

	Исключение
		ЗаписьЖурналаРегистрации(
			"_МС_МониторСаппорта.ОшибкаOTA",
			УровеньЖурналаРегистрации.Предупреждение,,,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())
		);
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область КэшированиеСеанса

// Сохраняет вычисленные на клиенте параметры AnyDesk / RuDesktop в параметры сеанса
Процедура СохранитьПараметрыУдаленногоДоступаСеанса(ПараметрыДоступа) Экспорт

	Попытка
		ПараметрыСеанса._МС_УдаленныйДоступТип = ПараметрыДоступа.type;
		ПараметрыСеанса._МС_УдаленныйДоступИД = ПараметрыДоступа.id;
	Исключение
		// Если параметры сеанса еще не объявлены в метаданных, сохраняем в регистр сведений или константу
	КонецПопытки;

КонецПроцедуры

// Извлечение параметров удаленного доступа для фонового задания
Функция _МС_ПолучитьПараметрыУдаленногоДоступа()

	Результат = Новый Структура;
	Результат.Вставить("type", "NONE");
	Результат.Вставить("id", "");

	Попытка
		Если НЕ ПустаяСтрока(ПараметрыСеанса._МС_УдаленныйДоступИД) Тогда
			Результат.type = ПараметрыСеанса._МС_УдаленныйДоступТип;
			Результат.id = ПараметрыСеанса._МС_УдаленныйДоступИД;
			Возврат Результат;
		КонецЕсли;
	Исключение
		// Параметры сеанса недоступны в контексте фонового задания регламентной службы
	КонецПопытки;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СборМетрикИПроверок

// Автоматическое определение названия магазина и рабочего места кассы
Функция _МС_ОпределитьПараметрыМагазинаИКассы()

	Результат = Новый Структура;
	Результат.Вставить("shop", "Магазин Розница");
	Результат.Вставить("workplace", "Касса 1");

	Попытка
		// Попытка извлечения рабочего места из стандартных БСП / Розница механизмов
		Если Метаданные.Справочники.Найти("РабочиеМеста") <> Неопределено Тогда
			ТекРМ = Справочники.РабочиеМеста.ПустаяСсылка();
			Попытка
				ТекРМ = ПараметрыСеанса.РабочееМестоКлиента;
			Исключение
			КонецПопытки;

			Если ЗначениеЗаполнено(ТекРМ) Тогда
				Результат.workplace = Строка(ТекРМ);
			КонецЕсли;
		КонецЕсли;

		// Попытка извлечения магазина / склада
		Если Метаданные.Справочники.Найти("Магазины") <> Неопределено Тогда
			Выборка = Справочники.Магазины.Выбрать();
			Если Выборка.Следующий() Тогда
				Результат.shop = СокрЛП(Выборка.Наименование);
			КонецЕсли;
		ИначеЕсли Метаданные.Справочники.Найти("Склады") <> Неопределено Тогда
			Выборка = Справочники.Склады.Выбрать();
			Если Выборка.Следующий() Тогда
				Результат.shop = СокрЛП(Выборка.Наименование);
			КонецЕсли;
		КонецЕсли;

	Исключение
		// Fallback на имя информационной базы и компьютера
		Результат.shop = Строка(Метаданные.Синоним);
		Результат.workplace = "Касса (" + ИмяКомпьютера() + ")";
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Проверка длительности кассовой смены (критично: смена > 24 часов блокирует печать чеков)
Процедура _МС_ПроверитьСостояниеКассовойСмены(МассивПредупреждений, МассивПроверокЗдоровья)

	Попытка
		Если Метаданные.Документы.Найти("КассоваяСмена") <> Неопределено Тогда
			Запрос = Новый Запрос;
			Запрос.Текст =
				"ВЫБРАТЬ ПЕРВЫЕ 1
				|	Док.Ссылка КАК Ссылка,
				|	Док.Дата КАК ДатаОткрытия,
				|	Док.СтатусКассовойСмены КАК Статус
				|ИЗ
				|	Документ.КассоваяСмена КАК Док
				|ГДЕ
				|	Док.Проведен = ИСТИНА
				|УПОРЯДОЧИТЬ ПО
				|	Док.Дата УБЫВ";

			РезультатЗапроса = Запрос.Выполнить();
			Если НЕ РезультатЗапроса.Пустой() Тогда
				Выборка = РезультатЗапроса.Выбрать();
				Выборка.Следующий();

				СтатусСмены = Строка(Выборка.Статус);
				Если СтрНайти(ВРег(СтатусСмены), "ОТКРЫТА") > 0 Тогда
					ЧасовОткрыта = (ТекущаяДата() - Выборка.ДатаОткрытия) / 3600;
					Если ЧасовОткрыта >= 24 Тогда
						ПредупреждениеТекст = СтрШаблон("Кассовая смена открыта более 24 часов (длительность: %1 ч.). Необходима Z-инкассация.", Окр(ЧасовОткрыта, 1));
						МассивПредупреждений.Добавить(ПредупреждениеТекст);

						ЧекItem = Новый Структура;
						ЧекItem.Вставить("id", "shift_duration_24h");
						ЧекItem.Вставить("name", "Длительность кассовой смены");
						ЧекItem.Вставить("status", "WARN");
						ЧекItem.Вставить("details", ПредупреждениеТекст);
						МассивПроверокЗдоровья.Добавить(ЧекItem);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	Исключение
		// Защита при отсутствии документа в текущей конфигурации
	КонецПопытки;

КонецПроцедуры

// Проверка регистра очереди неотправленных фискальных документов в ОФД
Процедура _МС_ПроверитьОчередьЧековОФД(МассивПредупреждений, МассивПроверокЗдоровья)

	Попытка
		// Проверка типичного регистра БСП/Торговли «ОчередьЧековККТ» или «ФискальныеОперации»
		ИмяРегистра = "";
		Если Метаданные.РегистрыСведений.Найти("ОчередьЧековККТ") <> Неопределено Тогда
			ИмяРегистра = "ОчередьЧековККТ";
		ИначеЕсли Метаданные.РегистрыСведений.Найти("ФискальныеЧеки") <> Неопределено Тогда
			ИмяРегистра = "ФискальныеЧеки";
		КонецЕсли;

		Если НЕ ПустаяСтрока(ИмяРегистра) Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = СтрШаблон(
				"ВЫБРАТЬ
				|	КОЛИЧЕСТВО(*) КАК ОчередьЧеков
				|ИЗ
				|	РегистрСведений.%1 КАК Рег", ИмяРегистра);

			Результат = Запрос.Выполнить();
			Если НЕ Результат.Пустой() Тогда
				Выборка = Результат.Выбрать();
				Выборка.Следующий();
				КоличествоЧеков = Выборка.ОчередьЧеков;
				Если КоличествоЧеков > 10 Тогда
					ПредупреждениеТекст = СтрШаблон("В очереди передачи в ОФД обнаружено %1 неотправленных чеков.", КоличествоЧеков);
					МассивПредупреждений.Добавить(ПредупреждениеТекст);

					ЧекItem = Новый Структура;
					ЧекItem.Вставить("id", "ofd_queue_backlog");
					ЧекItem.Вставить("name", "Буфер передачи чеков в ОФД");
					ЧекItem.Вставить("status", "WARN");
					ЧекItem.Вставить("details", ПредупреждениеТекст);
					МассивПроверокЗдоровья.Добавить(ЧекItem);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	Исключение
	КонецПопытки;

КонецПроцедуры

// Сбор последних ошибок из Журнала регистрации за 10 минут (лимит 50)
Функция _МС_ПолучитьОшибкиЖурналаРегистрации()

	МассивОшибок = Новый Массив;

	Попытка
		ФильтрЖР = Новый Структура;
		ФильтрЖР.Вставить("ДатаНачала", ТекущаяДата() - 600); // 10 минут = 600 секунд

		МассивУровней = Новый Массив;
		МассивУровней.Добавить(УровеньЖурналаРегистрации.Ошибка);
		ФильтрЖР.Вставить("Уровень", МассивУровней);

		ТаблицаЖР = Новый ТаблицаЗначений;
		ВыгрузитьЖурналРегистрации(
			ТаблицаЖР,
			ФильтрЖР,
			"Дата, ИмяСобытия, ОписаниеОшибки",
			50
		);

		Для Каждого СтрЛога Из ТаблицаЖР Цикл
			ЗаписьОшибки = Новый Структура;
			ЗаписьОшибки.Вставить("time", Формат(СтрЛога.Дата, "ДФ=yyyy-MM-ddTHH:mm:ssZ"));
			ЗаписьОшибки.Вставить("event", ?(ПустаяСтрока(СтрЛога.ИмяСобытия), "1C_Runtime_Error", СтрЛога.ИмяСобытия));
			ЗаписьОшибки.Вставить("error_text", СокрЛП(СтрЛога.ОписаниеОшибки));
			МассивОшибок.Добавить(ЗаписьОшибки);
		КонецЦикла;

	Исключение
		ЗаписьОшибки = Новый Структура;
		ЗаписьОшибки.Вставить("time", Формат(ТекущаяДата(), "ДФ=yyyy-MM-ddTHH:mm:ssZ"));
		ЗаписьОшибки.Вставить("event", "EventLog_Read_Error");
		ЗаписьОшибки.Вставить("error_text", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		МассивОшибок.Добавить(ЗаписьОшибки);
	КонецПопытки;

	Возврат МассивОшибок;

КонецФункции

// Сбор метаданных среды исполнения 1С
Функция _МС_СобратьСистемнуюИнформацию()

	Инфо = Новый Структура;

	Попытка
		СистемнаяИнформацияОбъект = Новый СистемнаяИнформация;
		Инфо.Вставить("platform_version", СистемнаяИнформацияОбъект.ВерсияПриложения);
		Инфо.Вставить("os", СистемнаяИнформацияОбъект.ВерсияОС);
		Инфо.Вставить("ram_gb", 8); // Приближенная константа кассового терминала
		Инфо.Вставить("computer_name", ИмяКомпьютера());
		Инфо.Вставить("app_name", Метаданные.Синоним);
	Исключение
		Инфо.Вставить("platform_version", "8.3");
		Инфо.Вставить("computer_name", ИмяКомпьютера());
	КонецПопытки;

	Возврат Инфо;

КонецФункции

#КонецОбласти

#Область СетевойТранспортИJSON

// Сериализация структуры в чистый формат JSON
Функция _МС_СериализоватьСтруктуруВJSON(ДанныеДляЗаписи)

	ЗаписьJSON = Новый ЗаписьJSON;
	ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(
		ПереносСтрокJSON.Нет,
		" ",
		Истина,
		ЭкранированиеСимволовJSON.СимволыВнеASCII
	);
	ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписи);

	ЗаписатьJSON(ЗаписьJSON, ДанныеДляЗаписи);
	СтрокаJSON = ЗаписьJSON.Закрыть();

	Возврат СтрокаJSON;

КонецФункции

// Отправка JSON пакета на сервер со строгим таймаутом 3 секунды
Функция _МС_ОтправитьПакетВШлюз(СтрокаJSON, Настройки)

	Попытка
		Заголовки = Новый Соответствие;
		Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Заголовки.Вставить("Authorization", "Bearer " + Настройки.Токен);

		Прокси = Неопределено;
		HTTPСоединение = Новый HTTPСоединение(
			Настройки.Хост,
			Настройки.Порт,,,
			Прокси,
			Настройки.ТаймаутСек,
			Новый ЗащищенноеСоединениеOpenSSL(),
			Настройки.ИспользоватьHTTPS
		);

		HTTPЗапрос = Новый HTTPЗапрос(Настройки.ПутьТелеметрии, Заголовки);
		HTTPЗапрос.УстановитьТелоИзСтроки(СтрокаJSON, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);

		HTTPОтвет = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);

		Возврат (HTTPОтвет.КодСостояния = 200 Или HTTPОтвет.КодСостояния = 201);

	Исключение
		// Stealth-режим: при сбое связи пакет тихо пропускается, нулевая нагрузка на интерфейс
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Сравнение версий ПО вида "1.0.1" > "1.0.0"
Функция _МС_ВерсияВыше(ВерсияА, ВерсияБ)

	МассивА = СтрРазделить(СокрЛП(ВерсияА), ".");
	МассивБ = СтрРазделить(СокрЛП(ВерсияБ), ".");

	МаксДлина = Макс(МассивА.Количество(), МассивБ.Количество());
	Для Индекс = 0 По МаксДлина - 1 Цикл
		ЧислоА = 0;
		Если Индекс < МассивА.Количество() Тогда
			ЧислоА = Число(МассивА[Индекс]);
		КонецЕсли;

		ЧислоБ = 0;
		Если Индекс < МассивБ.Количество() Тогда
			ЧислоБ = Число(МассивБ[Индекс]);
		КонецЕсли;

		Если ЧислоА > ЧислоБ Тогда
			Возврат Истина;
		ИначеЕсли ЧислоА < ЧислоБ Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

#КонецОбласти
