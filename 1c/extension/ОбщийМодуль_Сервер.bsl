// Сериализация структуры в чистый формат JSON
Функция _МС_СериализоватьСтруктуруВJSON(ДанныеДляЗаписи) Экспорт

	ЗаписьJSON = Новый ЗаписьJSON;
	ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(
		ПереносСтрокJSON.Нет,
		" ",
		Ложь,
		ЭкранированиеСимволовJSON.Нет
	);
	ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписи);

	ЗаписатьJSON(ЗаписьJSON, ДанныеДляЗаписи);
	СтрокаJSON = ЗаписьJSON.Закрыть();

	Возврат СтрокаJSON;

