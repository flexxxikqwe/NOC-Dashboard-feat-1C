// ==============================================================================
// ОБЩИЙ МОДУЛЬ: _МС_Сервер
// Свойства модуля в 1С:
//   - Сервер: Истина
//   - Внешнее соединение: Истина
//   - Клиент (управляемое приложение): Ложь
//   - Вызов сервера: Истина (Критично для вызова из &НаКлиенте)
//   - Привилегированный режим: Истина
// Назначение (Phase 4.1 Zero-Freeze):
//   1. Сбор прикладных метрик 1С (статус смены > 24ч, буфер ОФД, ошибки ЖР).
//   2. Атомарная запись пакета в локальную файловую очередь spool (%ProgramData%\1C-NOC\spool).
//   3. Нулевые блокировки кассира: никаких HTTP-вызовов, никакого WMI/COM.
//   4. Токены и сетевой транспорт полностью делегированы Windows Service (Phase 4.2).
// ==============================================================================

#Область КонстантыИНастройки

// Вспомогательная функция безопасного чтения переменной среды на сервере Windows
Функция _МС_ПолучитьПеременнуюСредыСервер(ИмяПеременной) Экспорт

	Попытка
		WshShell = Новый COMОбъект("WScript.Shell");
		Шаблон = "%" + ИмяПеременной + "%";
		Значение = WshShell.ExpandEnvironmentStrings(Шаблон);
		WshShell = Неопределено;

		// Если переменная не определена в Windows, WScript.Shell возвращает строку без изменений (%VARIABLE%)
		Если ВРег(СокрЛП(Значение)) = ВРег(Шаблон) Тогда
			Возврат "";
		КонецЕсли;

		Возврат СокрЛП(Значение);
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

// Получение пути к каталогу локальной очереди spool
// По умолчанию используется %ProgramData%\1C-NOC\spool
Функция _МС_ПолучитьКаталогSpool() Экспорт

	// 1. Быстрая проверка стандартного каталога Windows (без COM, нативный вызов 1С)
	КаталогПоУмолчанию = "C:\ProgramData\1C-NOC\spool";
	ФайлКаталога = Новый Файл(КаталогПоУмолчанию);
	Если ФайлКаталога.Существует() Тогда
		Возврат КаталогПоУмолчанию;
	КонецЕсли;

	// 2. Переопределение каталога через переменную среды NOC_SPOOL_DIR (тесты, стенды)
	КаталогИзСреды = _МС_ПолучитьПеременнуюСредыСервер("NOC_SPOOL_DIR");
	Если НЕ ПустаяСтрока(КаталогИзСреды) Тогда
		ФайлИзСреды = Новый Файл(КаталогИзСреды);
		Если ФайлИзСреды.Существует() Тогда
			Возврат КаталогИзСреды;
		КонецЕсли;
	КонецЕсли;

	// 3. Каталог ProgramData через переменную среды (если система на ином диске)
	КаталогProgramData = _МС_ПолучитьПеременнуюСредыСервер("ProgramData");
	Если НЕ ПустаяСтрока(КаталогProgramData) Тогда
		КаталогКастомный = КаталогProgramData + "\1C-NOC\spool";
		ФайлКастомный = Новый Файл(КаталогКастомный);
		Если ФайлКастомный.Существует() Тогда
			Возврат КаталогКастомный;
		КонецЕсли;
	КонецЕсли;

	// 4. Вспомогательный каталог временных файлов (для сред тестирования)
	КаталогВременный = КаталогВременныхФайлов() + "1C-NOC\spool";
	ФайлВременного = Новый Файл(КаталогВременный);
	Если ФайлВременного.Существует() Тогда
		Возврат КаталогВременный;
	КонецЕсли;

	// Если служба еще не инициализировала каталог очереди, возвращаем пустую строку
	Возврат "";

КонецФункции

// Проверка доступности очереди и защита от переполнения с приоритетным квотированием (Priority Backpressure Guard)
// Правило квотирования емкости (50 файлов максимум):
//   - Регулярная телеметрия ("TELEMETRY" / "NORMAL" / "LOW"): квота 40 файлов (80% емкости).
//   - Критические инциденты ("INCIDENT" / "HIGH"): квота 50 файлов (100% емкости).
//   - Слоты 41–50 физически зарезервированы под инциденты (предотвращение starvation).
Функция _МС_ПроверитьГотовностьИЛимитSpool(Знач КаталогSpool, Знач ТипСобытия = "TELEMETRY", Знач Приоритет = "NORMAL") Экспорт

	Если ПустаяСтрока(КаталогSpool) Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		ФайлКаталога = Новый Файл(КаталогSpool);
		Если НЕ ФайлКаталога.Существует() Тогда
			Возврат Ложь;
		КонецЕсли;

		// 1. Очистка зависших временных файлов temp_*.tmp старше 1 часа (защита от сбоев питания)
		Попытка
			МассивВременных = НайтиФайлы(КаталогSpool, "temp_*.tmp");
			ТекущийМомент = ТекущаяДата();
			Для Каждого ВременныйФайл Из МассивВременных Цикл
				Если (ТекущийМомент - ВременныйФайл.ПолучитьВремяИзменения()) > 3600 Тогда
					Попытка
						УдалитьФайлы(ВременныйФайл.ПолноеИмя);
					Исключение
					КонецПопытки;
				КонецЕсли;
			КонецЦикла;
		Исключение
		КонецПопытки;

		// 2. Расчет допустимого порога очереди для текущего типа события
		ЛимитДляСобытия = 40; // Базовая квота для регулярной телеметрии (TELEMETRY / NORMAL)
		Если ВРег(ТипСобытия) = "INCIDENT" ИЛИ ВРег(Приоритет) = "HIGH" Тогда
			ЛимитДляСобытия = 50; // Расширенная квота для инцидентов (10 зарезервированных слотов)
		КонецЕсли;

		// 3. Подсчет готовых .json файлов в очереди
		МассивФайлов = НайтиФайлы(КаталогSpool, "*.json");
		ТекущееКоличество = МассивФайлов.Количество();

		Если ТекущееКоличество >= ЛимитДляСобытия Тогда
			// Если инцидент не может быть записан из-за полного исчерпания очереди (50 файлов):
			Если ВРег(ТипСобытия) = "INCIDENT" ИЛИ ВРег(Приоритет) = "HIGH" Тогда
				Попытка
					ЗаписьЖурналаРегистрации(
						"1C_NOC.Spool.QueueOverflow",
						УровеньЖурналаРегистрации.Ошибка,
						,
						,
						СтрШаблон("Очередь spool переполнена (%1 файлов). Инцидент отклонен.", ТекущееКоличество)
					);
				Исключение
				КонецПопытки;
			КонецЕсли;
			Возврат Ложь;
		КонецЕсли;

		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Заглушка обратной совместимости (сетевой транспорт и токены изолированы в Windows Service)
// Переменные окружения NOC_SERVER_URL и NOC_TOKEN, а также файл 1C-NOC\config.json
// обрабатываются службой Windows (Phase 4.2). В Phase 4.1 расширение 1С изолировано от сетевых вызовов.
Функция _МС_ПолучитьНастройкиПодключения() Экспорт

	Настройки = Новый Структура;
	Настройки.Вставить("Хост", "127.0.0.1");
	Настройки.Вставить("Порт", 3000);
	Настройки.Вставить("ПутьТелеметрии", "/api/v1/telemetry");
	Настройки.Вставить("ПутьВерсии", "/api/v1/version");
	Настройки.Вставить("Токен", ""); // В Phase 4.1 токен изолирован в Windows Service (Phase 4.2/4.4)
	Настройки.Вставить("ТаймаутСек", 0);
	Настройки.Вставить("ИспользоватьHTTPS", Ложь);
	Настройки.Вставить("ИмяРасширения", "_МониторСаппорта");
	Настройки.Вставить("ТекущаяВерсия", "1.0.0");

	// Если ПустаяСтрока(Настройки.Токен) Тогда сетевые вызовы блокируются:
	// Расширение 1С не читает файл config.json и не обращается к секретам.
	// Bearer-токен авторизации добавляется исключительно службой Windows при передаче в NOC Hub.
	Возврат Настройки;

КонецФункции

#КонецОбласти

#Область ПрограммныйИнтерфейсРегламентныхЗаданий

// ------------------------------------------------------------------------------
// ПРОЦЕДУРА 1: РЕГЛАМЕНТНЫЙ МОНИТОРИНГ (Периодичность: раз в 10 минут)
// Формирует и атомарно публикует Spool Envelope v1.0 в очередь %ProgramData%\1C-NOC\spool
// Время выполнения на диске: < 1-3 мс. Нулевая зависимость от сети!
// ------------------------------------------------------------------------------
Процедура ВыполнитьРегламентныйМониторинг() Экспорт

	Попытка
		КаталогSpool = _МС_ПолучитьКаталогSpool();

		// 1. Проверка готовности очереди и Backpressure Guard (квота телеметрии: 40 файлов)
		Если НЕ _МС_ПроверитьГотовностьИЛимитSpool(КаталогSpool, "TELEMETRY", "NORMAL") Тогда
			Возврат;
		КонецЕсли;

		// 2. Определение параметров магазина и рабочего места кассы
		ПараметрыТочки = _МС_ОпределитьПараметрыМагазинаИКассы();

		// 3. Сбор прикладных предупреждений (смена > 24ч, буфер ОФД)
		МассивПредупреждений = Новый Массив;
		МассивПроверокЗдоровья = Новый Массив;

		_МС_ПроверитьСостояниеКассовойСмены(МассивПредупреждений, МассивПроверокЗдоровья);
		_МС_ПроверитьОчередьЧековОФД(МассивПредупреждений, МассивПроверокЗдоровья);

		// 4. Сбор критических ошибок Журнала регистрации за последние 10 минут
		МассивОшибок = _МС_ПолучитьОшибкиЖурналаРегистрации();

		// 5. Метаданные платформы и конфигурации 1С
		Сведения1С = _МС_СобратьСведения1С();

		// 6. Формирование прикладного payload (без секретов, без токенов)
		ПолезнаяНагрузка = Новый Структура;
		ПолезнаяНагрузка.Вставить("shop", ПараметрыТочки.shop);
		ПолезнаяНагрузка.Вставить("workplace", ПараметрыТочки.workplace);
		ПолезнаяНагрузка.Вставить("warnings", МассивПредупреждений);
		ПолезнаяНагрузка.Вставить("runtime_errors", МассивОшибок);
		ПолезнаяНагрузка.Вставить("health_checks", МассивПроверокЗдоровья);
		ПолезнаяНагрузка.Вставить("one_c_info", Сведения1С);

		// 7. Упаковка в стандартизованный конверт Spool Envelope v1.0
		ПакетSpool = _МС_СформироватьПакетSpool(ПолезнаяНагрузка, "TELEMETRY", "NORMAL");

		// 8. Атомарная запись в локальный spool (.tmp -> .json)
		_МС_ЗаписатьСобытиеВSpool(ПакетSpool, КаталогSpool);

	Исключение
		// Stealth Fail-Safe: сбой локальной записи никогда не прерывает работу кассира
	КонецПопытки;

КонецПроцедуры

// ------------------------------------------------------------------------------
// ПРОЦЕДУРА 2: АВТООБНОВЛЕНИЕ РАСШИРЕНИЯ (ДЕАКТИВИРОВАНО В 1С)
// Сетевой OTA-транспорт перенесен в Windows Service (Phase 4.2)
// ------------------------------------------------------------------------------
Процедура ВыполнитьАвтообновлениеРасширения() Экспорт

	// Phase 4.1: Прямые HTTP-запросы версии и скачивание .cfe из 1С полностью отключены.
	// Обновление артефактов выполняет нативная фоновая служба Windows без блокировки кассы.
	Возврат;

КонецПроцедуры

#КонецОбласти

#Область SpoolКонтрактИЗапись

// Получение точной временной метки UTC в формате ISO 8601 (с миллисекундами)
Функция _МС_ПолучитьМеткуВремениUTC(ВключатьМиллисекунды = Истина) Экспорт

	ТекущаяДатаUTC = ТекущаяУниверсальнаяДата();

	Если ВключатьМиллисекунды Тогда
		Попытка
			ЭпохаМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
			Миллисекунды = ЭпохаМс % 1000;
			СтрокаМс = Формат(Миллисекунды, "ЧЦ=3; ЧВН=; ЧГ=0");
			Возврат Формат(ТекущаяДатаUTC, "ДФ=yyyy-MM-ddTHH:mm:ss") + "." + СтрокаМс + "Z";
		Исключение
			Возврат Формат(ТекущаяДатаUTC, "ДФ=yyyy-MM-ddTHH:mm:ssZ");
		КонецПопытки;
	Иначе
		Возврат Формат(ТекущаяДатаUTC, "ДФ=yyyy-MM-ddTHH:mm:ssZ");
	КонецЕсли;

КонецФункции

// Получение компактной временной метки UTC для имени файла (строго 17 цифр: YYYYMMDDHHmmssfff)
Функция _МС_ПолучитьКомпактнуюМеткуВремениUTC() Экспорт

	ТекущаяДатаUTC = ТекущаяУниверсальнаяДата();
	БазоваяМетка = Формат(ТекущаяДатаUTC, "ДФ=yyyyMMddHHmmss"); // 14 цифр

	Попытка
		ЭпохаМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Миллисекунды = ЭпохаМс % 1000;
		СтрокаМс = Формат(Миллисекунды, "ЧЦ=3; ЧВН=; ЧГ=0");
		Возврат БазоваяМетка + СтрокаМс; // 17 цифр
	Исключение
		Возврат БазоваяМетка + "000"; // fallback ровно 17 цифр
	КонецПопытки;

КонецФункции

// Формирование структуры конверта Spool Envelope v1.0
Функция _МС_СформироватьПакетSpool(ПолезнаяНагрузка, Знач ТипСобытия = "TELEMETRY", Знач Приоритет = "NORMAL") Экспорт

	Пакет = Новый Структура;
	Пакет.Вставить("schema_version", "1.0");
	Пакет.Вставить("event_id", НРег(Строка(Новый УникальныйИдентификатор)));
	Пакет.Вставить("timestamp_utc", _МС_ПолучитьМеткуВремениUTC(Истина));
	Пакет.Вставить("source", "1C_EXTENSION");
	Пакет.Вставить("event_type", ТипСобытия);
	Пакет.Вставить("priority", Приоритет);
	Пакет.Вставить("payload", ПолезнаяНагрузка);

	Возврат Пакет;

КонецФункции

// Быстрая регистрация критического инцидента кассы (ККТ, ОФД, 1С) без ожидания 10-минутного таймера
Процедура ЗафиксироватьИнцидент(Знач Событие, Знач ОписаниеОшибки, Знач Приоритет = "HIGH") Экспорт

	Попытка
		КаталогSpool = _МС_ПолучитьКаталогSpool();
		Если НЕ _МС_ПроверитьГотовностьИЛимитSpool(КаталогSpool, "INCIDENT", Приоритет) Тогда
			Возврат;
		КонецЕсли;

		ПараметрыТочки = _МС_ОпределитьПараметрыМагазинаИКассы();

		МассивОшибок = Новый Массив;
		ЗаписьОшибки = Новый Структура;
		ЗаписьОшибки.Вставить("time", _МС_ПолучитьМеткуВремениUTC(Истина));
		ЗаписьОшибки.Вставить("event", ?(ПустаяСтрока(Событие), "1C_Critical_Incident", Событие));
		ЗаписьОшибки.Вставить("error_text", Лев(СокрЛП(ОписаниеОшибки), 1000));
		МассивОшибок.Добавить(ЗаписьОшибки);

		ПолезнаяНагрузка = Новый Структура;
		ПолезнаяНагрузка.Вставить("shop", ПараметрыТочки.shop);
		ПолезнаяНагрузка.Вставить("workplace", ПараметрыТочки.workplace);
		ПолезнаяНагрузка.Вставить("warnings", Новый Массив);
		ПолезнаяНагрузка.Вставить("runtime_errors", МассивОшибок);
		ПолезнаяНагрузка.Вставить("health_checks", Новый Массив);
		ПолезнаяНагрузка.Вставить("one_c_info", _МС_СобратьСведения1С());

		ПакетSpool = _МС_СформироватьПакетSpool(ПолезнаяНагрузка, "INCIDENT", Приоритет);
		_МС_ЗаписатьСобытиеВSpool(ПакетSpool, КаталогSpool);
	Исключение
		// Stealth Fail-Safe
	КонецПопытки;

КонецПроцедуры

// Безопасная атомарная запись пакета на диск (temp_<id>.tmp -> <ts>_<id>.json)
// Используются исключительно штатные средства 1С (ЗаписьТекста, ПереместитьФайл), без COM!
Функция _МС_ЗаписатьСобытиеВSpool(ПакетSpool, КаталогSpool) Экспорт

	Попытка
		СтрокаJSON = _МС_СериализоватьСтруктуруВJSON(ПакетSpool);

		// Контроль жесткого лимита в байтах UTF-8 (Payload Guard)
		ДвоичныеДанныеJSON = ПолучитьДвоичныеДанныеИзСтроки(СтрокаJSON, КодировкаТекста.UTF8, Ложь);
		РазмерБайт = ДвоичныеДанныеJSON.Размер();

		// Предупреждающий порог усечения: 55 000 байт (запас до 64 КБ для служебных полей службы)
		Если РазмерБайт > 55000 Тогда
			// При превышении порога усекаем длинные тексты ошибок
			Если ПакетSpool.payload.Свойство("runtime_errors") И ТипЗнч(ПакетSpool.payload.runtime_errors) = Тип("Массив") Тогда
				НовыйМассивОшибок = Новый Массив;
				Счетчик = 0;
				Для Каждого Ошибка Из ПакетSpool.payload.runtime_errors Цикл
					Счетчик = Счетчик + 1;
					Если Счетчик > 5 Тогда Прервать; КонецЕсли;
					КраткаяОшибка = Новый Структура;
					КраткаяОшибка.Вставить("time", Ошибка.time);
					КраткаяОшибка.Вставить("event", Ошибка.event);
					КраткаяОшибка.Вставить("error_text", Лев(Ошибка.error_text, 300));
					НовыйМассивОшибок.Добавить(КраткаяОшибка);
				КонецЦикла;
				ПакетSpool.payload.runtime_errors = НовыйМассивОшибок;
			КонецЕсли;

			// Усекаем массив предупреждений до 5 записей
			Если ПакетSpool.payload.Свойство("warnings") И ТипЗнч(ПакетSpool.payload.warnings) = Тип("Массив") Тогда
				Если ПакетSpool.payload.warnings.Количество() > 5 Тогда
					НовыеПредупреждения = Новый Массив;
					Для Индекс = 0 По 4 Цикл
						НовыеПредупреждения.Добавить(ПакетSpool.payload.warnings[Индекс]);
					КонецЦикла;
					ПакетSpool.payload.warnings = НовыеПредупреждения;
				КонецЕсли;
			КонецЕсли;

			СтрокаJSON = _МС_СериализоватьСтруктуруВJSON(ПакетSpool);
			ДвоичныеДанныеJSON = ПолучитьДвоичныеДанныеИзСтроки(СтрокаJSON, КодировкаТекста.UTF8, Ложь);
			РазмерБайт = ДвоичныеДанныеJSON.Размер();

			// Если даже после усечения размер пакета превышает 64 КБ (65536 байт), отбрасываем
			Если РазмерБайт > 65000 Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;

		EventID = ПакетSpool.event_id;
		МеткаВремени = _МС_ПолучитьКомпактнуюМеткуВремениUTC();

		ВременныйПуть = КаталогSpool + "\temp_" + EventID + ".tmp";
		ГотовыйПуть = КаталогSpool + "\" + МеткаВремени + "_" + EventID + ".json";

		// Шаг 1: Запись во временный файл (UTF-8 строго без BOM)
		ЗаписьТекста = Новый ЗаписьТекста(ВременныйПуть, КодировкаТекста.UTF8, , Ложь, Ложь);
		ЗаписьТекста.Записать(СтрокаJSON);
		ЗаписьТекста.Закрыть();

		// Шаг 2: Атомарная публикация через переименование на том же томе NTFS
		ПереместитьФайл(ВременныйПуть, ГотовыйПуть);

		Возврат Истина;

	Исключение
		// При сбое удаляем поврежденный временный файл, если он остался
		Попытка
			Если НЕ ПустаяСтрока(ВременныйПуть) Тогда
				УдалитьФайлы(ВременныйПуть);
			КонецЕсли;
		Исключение
		КонецПопытки;

		Возврат Ложь;
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СборМетрик1С

// Определение наименования магазина и рабочего места кассы
Функция _МС_ОпределитьПараметрыМагазинаИКассы()

	Результат = Новый Структура;
	Результат.Вставить("shop", "Магазин Розница");
	Результат.Вставить("workplace", "Касса 1");

	Попытка
		Если Метаданные.Справочники.Найти("РабочиеМеста") <> Неопределено Тогда
			ТекРМ = Справочники.РабочиеМеста.ПустаяСсылка();
			Попытка
				ТекРМ = ПараметрыСеанса.РабочееМестоКлиента;
			Исключение
			КонецПопытки;

			Если ЗначениеЗаполнено(ТекРМ) Тогда
				Результат.workplace = Строка(ТекРМ);
			КонецЕсли;
		КонецЕсли;

		Если Метаданные.Справочники.Найти("Магазины") <> Неопределено Тогда
			Выборка = Справочники.Магазины.Выбрать();
			Если Выборка.Следующий() Тогда
				Результат.shop = СокрЛП(Выборка.Наименование);
			КонецЕсли;
		ИначеЕсли Метаданные.Справочники.Найти("Склады") <> Неопределено Тогда
			Выборка = Справочники.Склады.Выбрать();
			Если Выборка.Следующий() Тогда
				Результат.shop = СокрЛП(Выборка.Наименование);
			КонецЕсли;
		КонецЕсли;

	Исключение
		Результат.shop = Строка(Метаданные.Синоним);
		Результат.workplace = "Касса (" + ИмяКомпьютера() + ")";
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Проверка длительности кассовой смены (смена > 24ч блокирует фискализацию чеков)
Процедура _МС_ПроверитьСостояниеКассовойСмены(МассивПредупреждений, МассивПроверокЗдоровья)

	Попытка
		Если Метаданные.Документы.Найти("КассоваяСмена") <> Неопределено Тогда
			Запрос = Новый Запрос;
			Запрос.Текст =
				"ВЫБРАТЬ ПЕРВЫЕ 1
				|	Док.Ссылка КАК Ссылка,
				|	Док.Дата КАК ДатаОткрытия,
				|	Док.СтатусКассовойСмены КАК Статус
				|ИЗ
				|	Документ.КассоваяСмена КАК Док
				|ГДЕ
				|	Док.Проведен = ИСТИНА
				|УПОРЯДОЧИТЬ ПО
				|	Док.Дата УБЫВ";

			РезультатЗапроса = Запрос.Выполнить();
			Если НЕ РезультатЗапроса.Пустой() Тогда
				Выборка = РезультатЗапроса.Выбрать();
				Выборка.Следующий();

				СтатусСмены = Строка(Выборка.Статус);
				Если СтрНайти(ВРег(СтатусСмены), "ОТКРЫТА") > 0 Тогда
					ЧасовОткрыта = (ТекущаяДата() - Выборка.ДатаОткрытия) / 3600;
					Если ЧасовОткрыта >= 24 Тогда
						ПредупреждениеТекст = СтрШаблон("Кассовая смена открыта более 24 часов (длительность: %1 ч.). Необходима Z-инкассация.", Окр(ЧасовОткрыта, 1));
						МассивПредупреждений.Добавить(ПредупреждениеТекст);

						ЧекItem = Новый Структура;
						ЧекItem.Вставить("id", "shift_duration_24h");
						ЧекItem.Вставить("name", "Длительность кассовой смены");
						ЧекItem.Вставить("status", "WARN");
						ЧекItem.Вставить("details", ПредупреждениеТекст);
						МассивПроверокЗдоровья.Добавить(ЧекItem);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	Исключение
	КонецПопытки;

КонецПроцедуры

// Проверка регистра очереди неотправленных чеков в ОФД
Процедура _МС_ПроверитьОчередьЧековОФД(МассивПредупреждений, МассивПроверокЗдоровья)

	Попытка
		ИмяРегистра = "";
		Если Метаданные.РегистрыСведений.Найти("ОчередьЧековККТ") <> Неопределено Тогда
			ИмяРегистра = "ОчередьЧековККТ";
		ИначеЕсли Метаданные.РегистрыСведений.Найти("ФискальныеЧеки") <> Неопределено Тогда
			ИмяРегистра = "ФискальныеЧеки";
		КонецЕсли;

		Если НЕ ПустаяСтрока(ИмяРегистра) Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = СтрШаблон(
				"ВЫБРАТЬ
				|	КОЛИЧЕСТВО(*) КАК ОчередьЧеков
				|ИЗ
				|	РегистрСведений.%1 КАК Рег", ИмяРегистра);

			Результат = Запрос.Выполнить();
			Если НЕ Результат.Пустой() Тогда
				Выборка = Результат.Выбрать();
				Выборка.Следующий();
				КоличествоЧеков = Выборка.ОчередьЧеков;
				Если КоличествоЧеков > 10 Тогда
					ПредупреждениеТекст = СтрШаблон("В очереди передачи в ОФД обнаружено %1 неотправленных чеков.", КоличествоЧеков);
					МассивПредупреждений.Добавить(ПредупреждениеТекст);

					ЧекItem = Новый Структура;
					ЧекItem.Вставить("id", "ofd_queue_backlog");
					ЧекItem.Вставить("name", "Буфер передачи чеков в ОФД");
					ЧекItem.Вставить("status", "WARN");
					ЧекItem.Вставить("details", ПредупреждениеТекст);
					МассивПроверокЗдоровья.Добавить(ЧекItem);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	Исключение
	КонецПопытки;

КонецПроцедуры

// Сбор последних критических ошибок Журнала регистрации (за последние 10 мин, лимит 50)
Функция _МС_ПолучитьОшибкиЖурналаРегистрации()

	МассивОшибок = Новый Массив;

	Попытка
		ФильтрЖР = Новый Структура;
		ФильтрЖР.Вставить("ДатаНачала", ТекущаяДата() - 600); // 10 минут

		МассивУровней = Новый Массив;
		МассивУровней.Добавить(УровеньЖурналаРегистрации.Ошибка);
		ФильтрЖР.Вставить("Уровень", МассивУровней);

		ТаблицаЖР = Новый ТаблицаЗначений;
		ВыгрузитьЖурналРегистрации(
			ТаблицаЖР,
			ФильтрЖР,
			"Дата, ИмяСобытия, ОписаниеОшибки",
			50
		);

		Для Каждого СтрЛога Из ТаблицаЖР Цикл
			ЗаписьОшибки = Новый Структура;
			ЗаписьОшибки.Вставить("time", Формат(СтрЛога.Дата, "ДФ=yyyy-MM-ddTHH:mm:ssZ"));
			ЗаписьОшибки.Вставить("event", ?(ПустаяСтрока(СтрЛога.ИмяСобытия), "1C_Runtime_Error", СтрЛога.ИмяСобытия));
			ЗаписьОшибки.Вставить("error_text", СокрЛП(СтрЛога.ОписаниеОшибки));
			МассивОшибок.Добавить(ЗаписьОшибки);
		КонецЦикла;

	Исключение
		ЗаписьОшибки = Новый Структура;
		ЗаписьОшибки.Вставить("time", Формат(ТекущаяДата(), "ДФ=yyyy-MM-ddTHH:mm:ssZ"));
		ЗаписьОшибки.Вставить("event", "EventLog_Read_Error");
		ЗаписьОшибки.Вставить("error_text", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		МассивОшибок.Добавить(ЗаписьОшибки);
	КонецПопытки;

	Возврат МассивОшибок;

КонецФункции

// Метаданные платформы и конфигурации 1С (чистый BSL, без WMI/COM)
Функция _МС_СобратьСведения1С()

	Инфо = Новый Структура;

	Попытка
		СистемнаяИнформацияОбъект = Новый СистемнаяИнформация;
		Инфо.Вставить("platform_version", СистемнаяИнформацияОбъект.ВерсияПриложения);
		Инфо.Вставить("configuration_name", Метаданные.Синоним);
		Инфо.Вставить("computer_name", ИмяКомпьютера());

		// Определение топологии информационной базы (Файловая vs Клиент-Серверная)
		СтрокаСоед = СтрокаСоединенияИнформационнойБазы();
		Если Найти(ВРег(СтрокаСоед), "FILE=") > 0 Тогда
			Инфо.Вставить("ib_mode", "FILE");
		Иначе
			Инфо.Вставить("ib_mode", "CLIENT_SERVER");
		КонецЕсли;
	Исключение
		Инфо.Вставить("platform_version", "8.3");
		Инфо.Вставить("computer_name", ИмяКомпьютера());
		Инфо.Вставить("ib_mode", "UNKNOWN");
	КонецПопытки;

	Возврат Инфо;

КонецФункции

